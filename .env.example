# --- Databricks ---
# Workspace URL, e.g. https://adb-1234567890.0.azuredatabricks.net
DATABRICKS_HOST=
DATABRICKS_TOKEN=
# The Unity Catalog catalog + schema the agent should recursively learn from.
DATABRICKS_CATALOG=
DATABRICKS_SCHEMA=

# --- Claude serving endpoint ---
# Full URL to your Claude serving endpoint (Databricks model serving, Anthropic, or compatible).
CLAUDE_ENDPOINT_URL=
# Bearer token used to authenticate to CLAUDE_ENDPOINT_URL. If unset, falls back to DATABRICKS_TOKEN.
CLAUDE_API_KEY=
# Model name to send in the request body (used by Databricks/Anthropic-compatible endpoints).
CLAUDE_MODEL=claude-3-5-sonnet

# --- Agent ---
# Seconds between recursive learning passes.
LEARN_INTERVAL_SECONDS=15
# Max sample rows to peek at per table when inferring patterns.
SAMPLE_ROW_LIMIT=20
# Where the knowledge base is persisted.
KNOWLEDGE_PATH=./data/knowledge.json
